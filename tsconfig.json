{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ugra/contracts": ["packages/contracts/src/index.ts"],
      "@ugra/core": ["packages/core/src/index.ts"],
      "@ugra/adapters": ["packages/adapters/src/index.ts"],
      "@ugra/db": ["packages/db/src/index.ts"],
      "@ugra/testkit": ["packages/testkit/src/index.ts"],
      "@ugra/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "modules/**/*.ts",
    "modules/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
