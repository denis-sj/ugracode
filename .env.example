# Один файл для локального запуска. В репозиторий не кладётся; здесь только имена и значения по умолчанию.
# Обязательные переменные — доступ к Polza. Остальное имеет значения по умолчанию в коде и Compose.
POLZA_API_KEY=
POLZA_BASE_URL=https://api.polza.ai/api/v1
LLM_MODEL_MAIN=deepseek/deepseek-v4.1-flash-1017
LLM_MODEL_CHEAP=deepseek/deepseek-v4.1-flash-1017
SPEECH_MODEL=ai-sage/gigaam-v3

# Не используются: агент с инструментами вместо RAG (2026-11-14)
EMBEDDINGS_MODEL=
EMBEDDINGS_DIM=

# Необязательные: по умолчанию подставляются в Compose и коде
